# ============================================================================
# mirror-server environment (.env)  —  template / documentation
# ----------------------------------------------------------------------------
# The real .env is NOT committed (loaded by dotenv at boot). This file documents
# every variable the code reads so a second environment (STAGING) can be stood
# up from a known contract instead of by hand. See docs/STAGING.md for the
# full staging runbook.
#
# LEGEND per variable:
#   [req]     must be set — the server misbehaves or is insecure without it
#   [secret]  a credential — NEVER commit a real value; staging uses its OWN
#   [env]     MUST differ between production and staging (port/DB/path/URL)
#   [opt]     optional; has a safe code default (shown)
#
# A staging stack on the SAME host MUST use its own DB, ports, storage dirs,
# internal secret, and Redis keyspace so it can never touch production data.
# The "STAGING:" note on the [env] vars is the value to use for the 9444/9445
# same-host staging stack described in docs/STAGING.md.
# ============================================================================

# ---- Runtime / process --------------------------------------------------
NODE_ENV=production                 # [req] 'production' in both prod and staging
MIRRORPORT=8444                     # [env] HTTPS port. STAGING: 9444
TRUST_PROXY_HOPS=1                  # [opt] hops to trust for X-Forwarded-For (default 1)
HOST=                              # [opt] bind host (default all interfaces)

# ---- TLS (in-process HTTPS) ---------------------------------------------
TUGRRPRIV=/path/to/privkey.pem      # [req][env] private key path. STAGING: staging cert (or a loopback self-signed)
TUGRRCERT=/path/to/cert.pem         # [req][env] certificate path
TUGRRINTERCERT=/path/to/chain.pem   # [opt] intermediate chain

# ---- Database (MySQL) ---------------------------------------------------
DB_HOST=127.0.0.1                   # [req]
DB_USER=mirror_user                 # [req][secret]
DB_PASSWORD=                        # [req][secret]
DB_NAME=mirror                      # [env] STAGING: mirror_staging  (a SEPARATE database)
DB_POOL_SIZE=30                     # [opt] pool size (default 30)

# ---- Redis (queues / cache) ---------------------------------------------
REDIS_HOST=127.0.0.1                # [req]
REDIS_PORT=6379                     # [opt] default 6379
REDIS_PASSWORD=                     # [secret]
REDIS_DB=0                          # [env] logical DB index. STAGING: a DIFFERENT index (e.g. 1) to isolate keys

# ---- Storage roots (encrypted user data on disk) ------------------------
MIRRORSTORAGE=/var/mirror/storage           # [req][env] STAGING: /var/mirror/staging/storage
MIRRORUSERSTORAGE=/var/mirror/users         # [req][env] STAGING: /var/mirror/staging/users
DINA_PURGE_PATH=                            # [opt] path used during account purge

# ---- Core secrets (auth / crypto) ---------------------------------------
# Staging MUST use DISTINCT secrets from prod. A staging token must never be
# valid against production.
JWT_SECRET=                         # [req][secret][env]
JWT_KEY=                            # [secret] legacy alias (keep == JWT_SECRET if used)
JWT_REFRESH_SECRET=                 # [req][secret][env]
SYSTEM_MASTER_KEY=                  # [req][secret][env] master encryption key — NEVER share prod's with staging
MIRROR_INTERNAL_SECRET=             # [req][secret][env] loopback trust for /admin/* — MUST match admin-server's; STAGING has its OWN
MIRROR_SERVICE_KEY=                 # [secret] service-to-service key
WAITLIST_CONFIRM_SECRET=            # [secret]
EMAIL_UNSUBSCRIBE_SECRET=           # [secret]
EMAIL_WEBHOOK_SECRET=               # [secret]

# ---- Web push (VAPID) ---------------------------------------------------
VAPID_PUBLIC_KEY=                   # [secret]
VAPID_PRIVATE_KEY=                  # [secret]
VAPID_SUBJECT=mailto:ops@example.com

# ---- Public URLs / origins ----------------------------------------------
APP_URL=https://www.theundergroundrailroad.world              # [env] STAGING: the staging origin
MIRROR_SELF_BASE_URL=https://127.0.0.1:8444                   # [env] loopback self-calls (the simulation uses this). STAGING: https://127.0.0.1:9444
EXTRA_ALLOWED_ORIGINS=                                        # [opt] comma-separated extra CORS origins
EMAIL_APP_URL=                                               # [opt] links in transactional email (defaults to APP_URL)
EMAIL_PUBLIC_BASE_URL=                                       # [opt]
EMAIL_LANDING_URL=                                           # [opt]

# ---- DINA (analysis engine) links ---------------------------------------
DINA_WS_URL=wss://localhost:8445/dina/ws     # [env] STAGING: wss://localhost:9445/dina/ws (real GPU dina via arbiter)
DINA_SERVER_URL=https://localhost:8445       # [env] STAGING: https://localhost:9445
DINA_ENDPOINT=                               # [opt]
DINA_BASE_URL=                               # [opt]
DINA_SERVICE_KEY=                            # [secret]
DINA_API_KEY=                                # [secret] alias
DINA_KEY=                                    # [secret] alias
USE_DINA_STUB=false                          # [opt] true = stub DINA (no GPU). Staging chose REAL GPU, so false.

# ---- Email provider -----------------------------------------------------
EMAIL_PROVIDER=resend                # [opt] provider name
EMAIL_DRY_RUN=false                  # [env] STAGING: true  (never send real email from staging)
RESEND_API_KEY=                      # [secret] (staging can leave blank when EMAIL_DRY_RUN=true)
EMAIL_API_KEY=                       # [secret] alias
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Mirror

# ---- Feature toggles / gates --------------------------------------------
LOGIN_REQUIRE_EMAIL_VERIFIED=false   # [opt] default false (unverified users see a banner)
STUDENT_ACCESS_ENABLED=true          # [opt]
MIRROR_SIM_EMAIL_DOMAIN=simulation.mirror.invalid  # [opt] reserved sim domain (never a real inbox)

# ---- Tuning knobs (safe code defaults — override only when needed) ------
# Queues:      QUEUE_MAX_CONCURRENT, QUEUE_MAX_RETRIES, QUEUE_POLL_INTERVAL
# TruthStream: TRUTHSTREAM_* (concurrency, rate limits, quality weights, min reviews)
# Personal:    PA_* (retries, poll, circuit breaker, LLM timeout)
# DINA chat:   DINA_CHAT_*, DINA_CIRCUIT_BREAKER_*, DINA_RATE_LIMIT_*, DINA_TIMEOUT, DINA_MAX_* , DINA_*_WORKERS
# Email:       EMAIL_BATCH_SIZE, EMAIL_SEND_RATE_PER_SEC, EMAIL_WORKER_POLL_MS, EMAIL_FALLBACK_*
# Push:        MAX_PUSH_PAYLOAD_BYTES, MAX_PUSH_SUBSCRIPTIONS_PER_USER
# Misc:        FEEDBACK_RATE_LIMIT, VOTE_DURATION_SECONDS, WAITLIST_RATE_LIMIT, AI_CHECKIN_INTERVAL_MS
# These carry defaults in code; leave unset unless you have a reason. Full list
# is enumerable via:  grep -rhoE "process\.env\.[A-Z_]+" --include=*.ts . | sort -u
